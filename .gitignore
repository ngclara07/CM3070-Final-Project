# ==============================================================
# Local archive
# ==============================================================

/archive/


# ==============================================================
# Python-generated files
# ==============================================================

__pycache__/
*.py[cod]
.pytest_cache/


# ==============================================================
# Local Python environments
# ==============================================================

.venv/
venv/


# ==============================================================
# Environment variables and credentials
# ==============================================================

.env
.env.*
!.env.example


# ==============================================================
# Dataset policy
#
# Ignore the full local dataset, but permit the curated,
# anonymised sample dataset under:
#
# data/session_aligned/sample/
# ==============================================================

/data/*

# Permit traversal into data/session_aligned
!/data/session_aligned/

/data/session_aligned/*

# Commit only the curated sample directory
!/data/session_aligned/sample/
!/data/session_aligned/sample/**


# ==============================================================
# Other processed datasets outside data/
# ==============================================================

/emosurv_processed/


# ==============================================================
# Model policy
#
# Retain small model-support files such as:
# - configuration files
# - tokenizers
# - metadata
# - CSV evaluation results
# - small demonstration pipelines
#
# Exclude only large pretrained model-weight files.
# ==============================================================

/models/**/*.safetensors


# ==============================================================
# Operating-system generated files
# ==============================================================

.DS_Store
Thumbs.db
Desktop.ini
